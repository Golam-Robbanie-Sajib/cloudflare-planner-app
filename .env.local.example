# .env.local.example (frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Groq API key for the LLM backend (model: openai/gpt-oss-120b). Get one at https://console.groq.com/keys
GROQ_API_KEY=your_real_groq_api_key

GOOGLE_CLIENT_ID=your_real_client_id
GOOGLE_CLIENT_SECRET=your_real_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback  # if using FastAPI
NEXT_PUBLIC_FIREBASE_API_KEY=your_real_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_real_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_real_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_real_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_real_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_real_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_real_firebase_measurement_id